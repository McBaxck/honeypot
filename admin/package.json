{
  "name": "holy-ui",
  "version": "0.1.0",
  "main": "public/electron.js",
  "description": "Interface d'administration du honeypot HolyPot",
  "author": "McBaxck",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.19",
    "cytoscape": "^3.28.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "flowbite-react": "^0.7.5",
    "js-cookie": "^3.0.5",
    "js-cookies": "^1.0.4",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.2.0",
    "react-modal": "^3.16.1",
    "react-scripts": "5.0.1",
    "react-switch": "^7.0.0",
    "react-toastify": "^10.0.4",
    "recharts": "^2.12.3",
    "sass": "^1.71.1",
    "tailwindcss": "^3.4.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none npm run start-react\" \"wait-on http://localhost:3000 && npm run start-electron\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start-react": "react-scripts start",
    "start-electron": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron": "npm run build && electron .",
    "release:mac": "npm run build && electron-builder --mac --publish=never"
  },
  "build": {
    "appId": "fr.mcbaxck.holyui",
    "productName": "HolyPot Admin",
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "icon": "public/logo512.png",
      "target": ["dmg", "zip"],
      "identity": null
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.1",
    "electron-builder": "^24.12.0",
    "wait-on": "^7.2.0"
  }
}
