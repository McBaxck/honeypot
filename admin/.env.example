# Base URL de l'API HolyPot, telle qu'atteignable depuis le navigateur (pas depuis un
# conteneur) : généralement localhost + le port publié par docker-compose pour le service api.
# Figée au build par Create React App (pas une vraie variable d'environnement runtime).
REACT_APP_API_BASE_URL=http://localhost:5050/holypot-api/v1
