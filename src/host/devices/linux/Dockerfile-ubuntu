# Use a base image with the desired OS (e.g., Ubuntu, Debian, etc.)
FROM ubuntu:latest
# Install SSH server (+ sudo: provides the "sudo" group used by useradd below)
RUN apt-get update && \
 apt-get install -y openssh-server sudo
# Create an SSH user (laisse useradd choisir un UID libre : les images ubuntu:latest
# récentes ont déjà un utilisateur par défaut en UID 1000)
RUN useradd -rm -d /home/sshuser -s /bin/bash -g root -G sudo sshuser
# Set the SSH user's password (replace "password" with your desired password)
RUN echo 'sshuser:password' | chpasswd
# Allow SSH access
RUN mkdir -p /var/run/sshd
# Expose the SSH port
EXPOSE 22
# Start SSH server on container startup
CMD ["/usr/sbin/sshd", "-D"]