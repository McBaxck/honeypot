POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=honeypot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternative to the POSTGRES_* vars above: set this directly instead.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/honeypot

# Adresse que le serveur FTP annonce aux clients en mode passif (PASV). Sans ça, derrière
# Docker, il annoncerait l'IP interne du conteneur, injoignable depuis l'extérieur.
# En local/dev : 127.0.0.1. En prod : l'IP ou le nom DNS publiquement joignable de l'hôte.
FTP_MASQUERADE_ADDRESS=127.0.0.1
